# Sandbox profile for the LangGraph content pipeline.
#
# Activate by running:  python -m pipeline.run --profile sandbox ...
# This file is ONLY read when --profile sandbox is passed; .env stays in
# control for prod runs.
#
# One-time setup before this file is usable:
# 1. In Notion, duplicate the production "Blog post pending publications"
#    database. Name the copy `Sandbox – Blog`. Copy its data source ID into
#    NOTION_BLOG_DATA_SOURCE_ID below.
# 2. Duplicate the "Research Tasks" database → `Sandbox – Research`. Copy
#    that data source ID into NOTION_RESEARCH_DATA_SOURCE_ID below.
# 3. Share both sandbox databases with the same Notion integration (same
#    NOTION_API_KEY works) via the "Connections" menu in Notion.
# 4. Create a parallel Obsidian vault dir:
#       cp -r obsidian-vault obsidian-vault-sandbox
#    or, to keep the prod vault a clean git submodule:
#       git -C obsidian-vault worktree add ../obsidian-vault-sandbox
# 5. Save this file as `.env.sandbox` (drop the .template suffix) and fill
#    in the IDs.
#
# Note: TELEGRAM_BOT_TOKEN / TELEGRAM_CHAT_ID can stay the same as prod;
# every sandbox message is auto-prefixed with `[SANDBOX] ` so you can mute
# / filter it on the Telegram side.

# ---- Notion (REQUIRED — pipeline fails fast if Notion DB IDs are unset) ----
NOTION_API_KEY=<paste sandbox or prod token>
NOTION_BLOG_DATA_SOURCE_ID=<paste data source ID of `Sandbox – Blog` DB>
NOTION_RESEARCH_DATA_SOURCE_ID=<paste data source ID of `Sandbox – Research` DB>

# ---- Telegram (REQUIRED — same chat as prod is fine) ----
TELEGRAM_BOT_TOKEN=<same as .env>
TELEGRAM_CHAT_ID=<same as .env>

# ---- Vault redirect (REQUIRED — must point at a parallel directory) ----
VAULT_PATH=/home/gonzalo/workspace/painforwisdom/painforwisdom/obsidian-vault-sandbox

# ---- LangGraph checkpoint isolation (REQUIRED — separates HITL state) ----
CHECKPOINT_DB_PATH=/home/gonzalo/workspace/painforwisdom/painforwisdom/pipeline/checkpoints-sandbox.db

# ---- Anthropic / LLM auth (same as prod — share quota) ----
ANTHROPIC_AUTH_TOKEN=<same as .env>

# Marker — useful for logs / scripts asserting they are running in sandbox.
PIPELINE_PROFILE=sandbox
